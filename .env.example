# NVIDIA NIM (for agentic analysis)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub (for MCP auth)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local LLM (byte-vision-mcp)
LLAMA_CPP_MODEL_PATH=/path/to/your/model.gguf
LLAMA_CPP_N_GPU_LAYERS=35

# Musepool CDN preference: alibaba | tsinghua | pypi
MUSEPOOL_CDN=alibaba

# Lens endpoint
LENS_ENDPOINT=http://127.0.0.1:25115

# Output
VOLUME_OUTPUT_DIR=./data/output
VOLUME_CACHE_DIR=./data/cache
