{
  "repo": "toxicwind/additional-lens-profiles",
  "description": "ARC-AGI Swarm \u2014 Hyper-modular NVIDIA-NIM agent orchestration",
  "structure": {
    "src/nvidia_swarm/": [
      "__init__.py",
      "core.py",
      "agent.py",
      "transport.py",
      "lens.py",
      "main.py",
      "miniswarm.py"
    ],
    "src/iptv_discovery/": [
      "__init__.py",
      "discovery.py",
      "deep_scan.py"
    ],
    "src/benchmarks/": [
      "__init__.py",
      "references.py",
      "references.json",
      "runner.py"
    ],
    "case-study-01-groq-deprecation/": [
      "README.md",
      "groq_email_raw.md",
      "osint_report.md",
      "migration_guide.md",
      "swarm_task_manifest.json",
      "execution_log.md"
    ],
    "data/aug2026/": [
      "iptv_stremio_repos.jsonl",
      "nuvio_repos.json",
      "deep_scan.json",
      "summary.json",
      "lens.py"
    ],
    "data/benchmarks/": [
      "references.json"
    ],
    "docs/": [
      "ARCHITECTURE.md",
      "BENCHMARK_BASELINES.md",
      "API.md",
      "TUNNEL.md"
    ],
    ".github/workflows/": [
      "ci.yml",
      "benchmark.yml",
      "swarm.yml"
    ],
    "lenses/": [
      "anthropological.py",
      "cryptographic.py",
      "insectoid.py",
      "osint.py",
      "stylometric.py"
    ],
    "archive/": [
      "legacy_scripts/",
      "old_iterations/"
    ],
    "root": [
      "README.md",
      "LICENSE",
      "requirements.txt",
      ".gitignore",
      ".env.example"
    ]
  },
  "rules": [
    "No .py files in root except __init__",
    "No credentials committed",
    "All .env files in .gitignore",
    "One case study per folder",
    "All swarm modules in src/nvidia_swarm/"
  ]
}